# ═══════════════════════════════════════════════════════════════
# DEVIZIER AI — variabile de mediu
# Copiază acest fișier ca .env și completează valorile reale.
# NU publica niciodată .env-ul real (parole) pe GitHub.
# ═══════════════════════════════════════════════════════════════

# ── Supabase (PRODUCȚIE — Vercel) ──────────────────────────────
# Din Supabase: Project Settings → Database → Connection string
# DATABASE_URL = „Transaction pooler" (port 6543) + ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.PROIECT_REF:PAROLA_TA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL = „Session pooler" sau „Direct connection" (port 5432)
DIRECT_URL="postgresql://postgres.PROIECT_REF:PAROLA_TA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Secret pentru semnarea cookie-urilor de sesiune (OBLIGATORIU în producție).
# Generează unul nou:  openssl rand -hex 32   (sau orice string random de 40+ caractere)
AUTH_SECRET="schimbă-cu-un-string-random-lung-de-64-caractere"

# ── Dezvoltare 100% locală (fără Supabase, opțional) ───────────
# Ca să rulezi local pe SQLite: comentează DATABASE_URL/DIRECT_URL de mai sus
# și decomentează linia de jos, apoi:
#   npx prisma generate --schema prisma/schema.sqlite.prisma
#   npx prisma db push --schema prisma/schema.sqlite.prisma
# DATABASE_URL="file:../db/custom.db"
